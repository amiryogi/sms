# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# all env files except the example (real API URLs and tokens stay local)
.env
.env.*
!.env.example

# test coverage
coverage/

# Firebase / FCM credentials (docs/BUILD_AND_DEPLOYMENT.md -> Push notifications).
# The service-account key is a secret; never commit it.
google-services.json
GoogleService-Info.plist
*service-account*.json
*firebase-adminsdk*.json
