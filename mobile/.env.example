# Copy to .env.development.local (never commit real values).
# The API the app talks to, including /api/v1. On a phone, use the computer's
# LAN address, not localhost: http://192.168.1.20:5000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# development | preview | production. Production refuses a non-HTTPS API URL.
APP_ENV=development
