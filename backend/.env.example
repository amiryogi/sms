# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Placeholders only in this file.

# Environment
NODE_ENV=development
PORT=5000

# Database (read by Prisma — prisma/schema.prisma datasource)
# URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/school_management"

# JWT — generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production the server refuses to start if these are unset.
JWT_SECRET=replace-with-64-hex-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-64-hex-random-string
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Cloudinary (Optional — leave blank to use local ./uploads only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (added to the CORS allow-list alongside localhost:5173/5174)
FRONTEND_URL=http://localhost:3000
