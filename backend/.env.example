# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Placeholders only in this file.

# Environment
NODE_ENV=development
PORT=5000

# Database — pick ONE provider (required; the server refuses to start without it)
# URL-encode special characters in passwords (e.g. @ -> %40).
DATABASE_PROVIDER=mysql

# MySQL 8 (DATABASE_PROVIDER=mysql)
MYSQL_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/school_management"

# Supabase PostgreSQL (DATABASE_PROVIDER=supabase). From Project Settings -> Database:
#   pooled connection (port 6543) for the app, direct connection (port 5432) for migrations.
#   The direct host is IPv6-only: on a network without IPv6, use the Session pooler string
#   (pooler host, port 5432) as SUPABASE_DIRECT_URL instead.
# SUPABASE_DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# SUPABASE_DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require"

# Test databases (integration tests only; never the databases above)
# MYSQL_TEST_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/sms_test"   # default: MYSQL_DATABASE_URL with /sms_test
# SUPABASE_TEST_DATABASE_URL="postgresql://...pooler...:6543/postgres?pgbouncer=true&sslmode=require"
# SUPABASE_TEST_DIRECT_URL="postgresql://...:5432/postgres?sslmode=require"

# JWT — generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production the server refuses to start if these are unset.
JWT_SECRET=replace-with-64-hex-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-64-hex-random-string
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Cloudinary (optional locally; REQUIRED on Vercel, which has no disk — docs/deploy-vercel.md).
# Leave blank to store uploads in ./uploads. On Vercel also set MAX_FILE_SIZE=4194304.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (added to the CORS allow-list alongside localhost:5173/5174)
FRONTEND_URL=http://localhost:3000
