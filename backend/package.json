{
  "name": "sms-backend",
  "version": "1.0.0",
  "description": "K-12 School Management System Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "node -e \"if(!require('fs').existsSync('scripts/db.js')){console.log('postinstall: no scripts/db.js in '+process.cwd()+' (cPanel installs packages in its own folder). Run in the app folder: node scripts/db.js generate');process.exit(0)}require('child_process').execFileSync(process.execPath,['scripts/db.js','generate'],{stdio:'inherit'})\"",
    "db:schemas": "node scripts/db.js schemas",
    "db:schemas:check": "node scripts/db.js schemas:check",
    "db:generate": "node scripts/db.js generate",
    "db:validate": "node scripts/db.js validate",
    "db:migrate:deploy": "node scripts/db.js migrate:deploy",
    "db:status": "node scripts/db.js status",
    "db:studio": "node scripts/db.js studio",
    "seed": "node prisma/seed.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "npm run test:integration:mysql",
    "test:integration:mysql": "node scripts/with-test-db.js --provider mysql jest -c jest.integration.config.js --runInBand",
    "test:integration:pg": "node scripts/with-test-db.js --provider pg jest -c jest.integration.config.js --runInBand",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "school",
    "management",
    "education",
    "k12"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "5.22.0",
    "validator": "13.15.26",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
