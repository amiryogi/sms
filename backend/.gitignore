# Dependencies
node_modules/

# Environment files — real secrets live here, never commit them
.env
.env.*
!.env.example
# frontend/.env is covered by the root .gitignore (gitignore patterns cannot
# reach outside their own directory, so it cannot be listed here).

# Logs
logs/
*.log
npm-debug.log*

# Uploads
uploads/*
!uploads/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/

# Test coverage
coverage/

# Prisma
# NOTE: prisma/migrations/ is intentionally TRACKED — migrations are the
# schema history and must be in version control. Do not re-add it here.
