# ---------------------------------------------------------------------------
# Repo-wide ignores. Applies to backend/, frontend/ and the repo root.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Environment files — these hold real credentials (DB password, JWT secrets,
# Cloudinary secret). Matches backend/.env, frontend/.env, .env.local, etc.
.env
.env.*
!.env.example
!.env.*.example

# Database dumps at the repo root. A dump of a live school database contains
# student and parent names, email addresses and bcrypt password hashes, and this
# repository is public. Keep backups in cloud storage or on a USB stick instead
# -- see "Syncing the database" in docs/SETUP-NEW-MACHINE.md.
# Scoped to the root so backend/prisma/migrations/**/migration.sql and
# database/schema.sql stay tracked.
/*.sql

# Build output
dist/
dist-ssr/
build/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*.suo
*.local

# OS junk
.DS_Store
Thumbs.db
