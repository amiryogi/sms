# ---------------------------------------------------------------------------
# Repo-wide ignores. Applies to backend/, frontend/ and the repo root.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Environment files — these hold real credentials (DB password, JWT secrets,
# Cloudinary secret). Matches backend/.env, frontend/.env, .env.local, etc.
.env
.env.*
!.env.example
!.env.*.example

# Build output
dist/
dist-ssr/
build/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*.suo
*.local

# OS junk
.DS_Store
Thumbs.db
